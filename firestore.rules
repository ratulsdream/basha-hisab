rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validCategory(value) { return value in ['uncategorized','food','rice','vegetables','household','utilities','other']; }
    function validCalendar(data) {
      return data.date is timestamp && data.date >= timestamp.date(2000,1,1) && data.date < timestamp.date(2101,1,1)
        && data.month is string && data.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && data.month == string(data.date.year()) + '-' + (data.date.month() < 10 ? '0' : '') + string(data.date.month());
    }
    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function housePath(id) { return /databases/$(database)/documents/households/$(id); }
    function minePath(uid, id) { return /databases/$(database)/documents/users/$(uid)/memberships/$(id); }
    function memberPath(id, uid) { return /databases/$(database)/documents/households/$(id)/members/$(uid); }
    function invitePath(code) { return /databases/$(database)/documents/invites/$(code); }
    // memberIds remains the atomic authority, including unmigrated v1 members.
    // Only the paired membership operations below may change this array.
    function member(id) {
      return signedIn() && request.auth.uid in get(housePath(id)).data.memberIds;
    }
    function validName(value) { return value is string && value.size() > 0 && value.size() <= 50; }
    function capacity(data) { return data.get('maxMembers', 2); }
    function validHouse(data) {
      return data.keys().hasAll(['memberIds','memberNames','currency','inviteCode','createdAt'])
        && data.keys().hasOnly(['memberIds','memberNames','currency','inviteCode','createdAt','title','maxMembers','legacyMemberIds'])
        && data.memberIds is list && data.memberIds.size() <= capacity(data)
        && capacity(data) is int && capacity(data) == 2
        && data.memberIds.toSet().size() == data.memberIds.size()
        && data.memberNames is map && data.memberNames.keys().hasAll(data.memberIds)
        && data.currency in ['BDT','USD','EUR','GBP','INR']
        && data.inviteCode is string && data.inviteCode.matches('^[a-f0-9]{32}$')
        && data.createdAt is timestamp
        && (!('title' in data) || validName(data.title))
        && (!('legacyMemberIds' in data) || (data.legacyMemberIds is list && data.legacyMemberIds.size() >= 1 && data.legacyMemberIds.size() <= 2 && data.memberNames.keys().hasAll(data.legacyMemberIds)));
    }
    function validProfile(data, uid) {
      return data.keys().hasAll(['uid','email','displayName','createdAt','updatedAt'])
        && data.keys().hasOnly(['uid','email','displayName','createdAt','updatedAt','householdId','name','inviteCode','legacyMembershipMigrated'])
        && data.uid == uid && data.email is string && data.email.size() <= 320
        && data.email == request.auth.token.email
        && validName(data.displayName) && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }
    function validMembership(data, uid, id) {
      return data.keys().hasAll(['uid','groupId','displayName','joinedAt','inviteCode'])
        && data.keys().hasOnly(['uid','groupId','displayName','joinedAt','inviteCode'])
        && data.uid == uid && data.groupId == id && validName(data.displayName)
        && data.joinedAt == request.time
        && data.inviteCode == getAfter(housePath(id)).data.inviteCode
        && uid in getAfter(housePath(id)).data.memberIds;
    }
    function pairedMembership(uid, id) {
      return getAfter(minePath(uid, id)).data == getAfter(memberPath(id, uid)).data;
    }
    match /users/{uid} {
      match /preferences/{preference} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid && preference == 'notifications'
          && request.resource.data.keys().hasOnly(['enabled','remote','zone','kinds','updatedAt'])
          && request.resource.data.enabled is bool && request.resource.data.remote is bool
          && request.resource.data.zone in ['Europe/Nicosia','Europe/Athens','Europe/London','Asia/Dhaka','UTC']
          && request.resource.data.kinds.keys().hasOnly(['expense','shopping','stock','recurring','settlement','budget'])
          && request.resource.data.kinds.keys().hasAll(['expense','shopping','stock','recurring','settlement','budget'])
          && request.resource.data.kinds.expense is bool && request.resource.data.kinds.shopping is bool
          && request.resource.data.kinds.stock is bool && request.resource.data.kinds.recurring is bool
          && request.resource.data.kinds.settlement is bool && request.resource.data.kinds.budget is bool
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      match /devices/{device} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && device.matches('^[a-f0-9]{64}$')
          && request.resource.data.keys().hasOnly(['token','platform','enabled','updatedAt'])
          && request.resource.data.token is string && request.resource.data.token.size() > 0 && request.resource.data.token.size() <= 4096
          && request.resource.data.platform in ['android','ios'] && request.resource.data.enabled is bool
          && request.resource.data.updatedAt == request.time;
      }

      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && validProfile(request.resource.data, uid)
        && request.resource.data.createdAt == request.time
        && !request.resource.data.keys().hasAny(['householdId','name','inviteCode','legacyMembershipMigrated']);
      allow update: if signedIn() && request.auth.uid == uid
        && validProfile(request.resource.data, uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid','email','displayName','createdAt','updatedAt','legacyMembershipMigrated'])
        && (!('createdAt' in resource.data) ? request.resource.data.createdAt == request.time : request.resource.data.createdAt == resource.data.createdAt)
        && (!('legacyMembershipMigrated' in request.resource.data) || request.resource.data.legacyMembershipMigrated == true);
      allow delete, list: if false;
      match /personalExpenses/{expense} {
        function owner() { return signedIn() && request.auth.uid == uid; }
        function validPersonal(data) {
          return data.keys().hasAll(['merchant','payer','date','month','itemCount','total','createdBy','createdAt','scope','kind','category','groupId'])
            && data.keys().hasOnly(['merchant','payer','date','month','itemCount','total','createdBy','createdAt','scope','kind','category','groupId'])
            && data.scope == 'personal' && data.kind in ['expense','refund'] && validCategory(data.category)
            && data.merchant is string && data.merchant.size() > 0 && data.merchant.size() <= 100
            && data.payer == uid && data.createdBy == uid && data.createdAt == request.time && validCalendar(data)
            && data.total is int && data.total > 0 && data.total <= 1000000000 && data.itemCount is int && data.itemCount >= 0 && data.itemCount <= 100
            && data.groupId is string && member(data.groupId);
        }
        allow read: if owner();
        allow create: if owner() && validPersonal(request.resource.data);
        allow update, delete: if false;
        match /items/{line} {
          function parentPath() { return /databases/$(database)/documents/users/$(uid)/personalExpenses/$(expense); }
          allow read: if owner();
          allow create: if owner() && !exists(parentPath()) && getAfter(parentPath()).data.createdBy == uid && getAfter(parentPath()).data.createdAt == request.time
            && request.resource.data.keys().hasAll(['name','amount','index'])
            && request.resource.data.keys().hasOnly(['name','amount','index','quantityMilli','unit'])
            && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
            && request.resource.data.amount is int && request.resource.data.amount >= 0 && request.resource.data.amount <= 1000000000
            && request.resource.data.index is int && request.resource.data.index >= 0 && request.resource.data.index < getAfter(parentPath()).data.itemCount && line == string(request.resource.data.index)
            && (!('quantityMilli' in request.resource.data) || (request.resource.data.quantityMilli is int && request.resource.data.quantityMilli > 0 && request.resource.data.quantityMilli <= 100000000 && request.resource.data.unit in ['each','g','kg','ml','l']))
            && (!('unit' in request.resource.data) || 'quantityMilli' in request.resource.data);
          allow update, delete: if false;
        }
      }
      match /personalReceiptSignatures/{expense} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasAll(['expenseId','signature','imageHash','createdBy','at'])
          && request.resource.data.keys().hasOnly(['expenseId','signature','imageHash','createdBy','at'])
          && request.resource.data.expenseId == expense && request.resource.data.createdBy == uid && request.resource.data.at == request.time
          && request.resource.data.signature.matches('^[a-f0-9]{64}$') && (request.resource.data.imageHash == '' || request.resource.data.imageHash.matches('^[a-f0-9]{64}$'))
          && exists(/databases/$(database)/documents/users/$(uid)/personalExpenses/$(expense));
        allow update, delete: if false;
      }
      match /memberships/{id} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && validMembership(request.resource.data, uid, id) && pairedMembership(uid, id);
        allow delete: if signedIn() && request.auth.uid == uid
          && !(uid in getAfter(housePath(id)).data.memberIds)
          && !existsAfter(memberPath(id, uid));
        allow update: if false;
      }
    }
    match /invites/{code} {
      // 128-bit bearer invitation, get-only; never permit enumeration.
      allow get: if signedIn();
      allow create: if signedIn() && code.matches('^[a-f0-9]{32}$')
        && request.resource.data.keys().hasAll(['householdId','ownerId','createdAt'])
        && request.resource.data.keys().hasOnly(['householdId','ownerId','createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && !exists(housePath(request.resource.data.householdId))
        && getAfter(housePath(request.resource.data.householdId)).data.memberIds == [request.auth.uid]
        && getAfter(housePath(request.resource.data.householdId)).data.inviteCode == code;
      allow list, update, delete: if false;
    }
    match /households/{id} {
      allow get: if member(id);
      allow list: if false;
      allow create: if signedIn() && validHouse(request.resource.data)
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.memberNames.keys().hasOnly([request.auth.uid])
        && validName(request.resource.data.memberNames[request.auth.uid])
        && request.resource.data.get('maxMembers', 0) == 2
        && !('legacyMemberIds' in request.resource.data)
        && request.resource.data.createdAt == request.time
        && exists(userPath(request.auth.uid))
        && pairedMembership(request.auth.uid, id)
        && getAfter(minePath(request.auth.uid, id)).data.inviteCode == request.resource.data.inviteCode
        && getAfter(invitePath(request.resource.data.inviteCode)).data.householdId == id
        && getAfter(invitePath(request.resource.data.inviteCode)).data.ownerId == request.auth.uid;
      allow update: if signedIn() && validHouse(request.resource.data) && (
        // Join: atomically add only oneself with the real invite and paired records.
        (!(request.auth.uid in resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds','memberNames'])
          && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([request.auth.uid])
          && validName(request.resource.data.memberNames[request.auth.uid])
          && pairedMembership(request.auth.uid, id)
          && getAfter(minePath(request.auth.uid, id)).data.inviteCode == resource.data.inviteCode
          && getAfter(minePath(request.auth.uid, id)).data.displayName == request.resource.data.memberNames[request.auth.uid]
          && get(invitePath(resource.data.inviteCode)).data.householdId == id)
        ||
        // Leave: preserve names and all expenses, remove both access records.
        (request.auth.uid in resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds','legacyMemberIds'])
          && (('legacyMemberIds' in resource.data) ? request.resource.data.legacyMemberIds == resource.data.legacyMemberIds : request.resource.data.legacyMemberIds == resource.data.memberIds)
          && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid])
          && !existsAfter(minePath(request.auth.uid, id))
          && !existsAfter(memberPath(id, request.auth.uid)))
      );
      allow delete: if false;
      match /members/{uid} {
        allow read: if member(id);
        allow create: if signedIn() && request.auth.uid == uid
          && validMembership(request.resource.data, uid, id) && pairedMembership(uid, id);
        allow delete: if signedIn() && request.auth.uid == uid
          && !(uid in getAfter(housePath(id)).data.memberIds)
          && !existsAfter(minePath(uid, id));
        allow update: if false;
      }
      function editedByMember(data) { return member(id) && data.updatedBy == request.auth.uid && data.updatedAt == request.time; }
      function category(value) { return value in ['uncategorized','food','rice','vegetables','household','utilities','other']; }
      function unit(value) { return value in ['each','g','kg','ml','l']; }
      function catalogPath(item) { return /databases/$(database)/documents/households/$(id)/catalog/$(item); }
      function catalogChangePath(item, revision) { return /databases/$(database)/documents/households/$(id)/catalogChanges/$(item + '_' + string(revision)); }
      function validCatalog(data) {
        return data.keys().hasAll(['name','category','mergedInto','revision','updatedBy','updatedAt'])
          && data.keys().hasOnly(['name','category','mergedInto','revision','updatedBy','updatedAt'])
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && category(data.category) && data.mergedInto is string && data.revision is int && data.revision >= 0
          && editedByMember(data);
      }
      match /catalog/{item} {
        allow read: if member(id);
        allow create: if item.matches('^[a-f0-9]{64}$') && validCatalog(request.resource.data)
          && request.resource.data.revision == 0 && request.resource.data.mergedInto == '';
        allow update: if validCatalog(request.resource.data)
          && request.resource.data.revision == resource.data.revision + 1
          && (request.resource.data.mergedInto == '' || (request.resource.data.mergedInto != item && exists(catalogPath(request.resource.data.mergedInto)) && getAfter(catalogPath(request.resource.data.mergedInto)).data.mergedInto == ''))
          && getAfter(catalogChangePath(item,request.resource.data.revision)).data.before == {'name':resource.data.name,'category':resource.data.category,'mergedInto':resource.data.mergedInto}
          && getAfter(catalogChangePath(item,request.resource.data.revision)).data.after == {'name':request.resource.data.name,'category':request.resource.data.category,'mergedInto':request.resource.data.mergedInto};
        allow delete: if false;
      }
      match /catalogChanges/{change} {
        allow read: if member(id);
        allow create: if member(id) && request.resource.data.keys().hasAll(['itemId','revision','before','after','actor','at'])
          && request.resource.data.keys().hasOnly(['itemId','revision','before','after','actor','at'])
          && request.resource.data.actor == request.auth.uid && request.resource.data.at == request.time
          && request.resource.data.revision is int
          && change == request.resource.data.itemId + '_' + string(request.resource.data.revision)
          && getAfter(catalogPath(request.resource.data.itemId)).data.revision == request.resource.data.revision
          && get(catalogPath(request.resource.data.itemId)).data.revision + 1 == request.resource.data.revision;
        allow update, delete: if false;
      }
      function aliasPath(alias) { return /databases/$(database)/documents/households/$(id)/itemAliases/$(alias); }
      function aliasChangePath(alias,revision) { return /databases/$(database)/documents/households/$(id)/aliasChanges/$(alias + '_' + string(revision)); }
      match /itemAliases/{alias} {
        function validAlias(data) {
          return alias.matches('^[a-f0-9]{64}$') && editedByMember(data)
            && data.keys().hasAll(['itemId','alias','active','revision','updatedBy','updatedAt'])
            && data.keys().hasOnly(['itemId','alias','active','revision','updatedBy','updatedAt'])
            && data.alias is string && data.alias.size() > 0 && data.alias.size() <= 100
            && data.active is bool && data.revision is int && existsAfter(catalogPath(data.itemId));
        }
        allow read: if member(id);
        allow create: if validAlias(request.resource.data) && request.resource.data.revision == 0 && request.resource.data.active == true;
        allow update: if validAlias(request.resource.data) && request.resource.data.alias == resource.data.alias
          && request.resource.data.revision == resource.data.revision + 1
          && getAfter(aliasChangePath(alias,request.resource.data.revision)).data.before == {'itemId':resource.data.itemId,'active':resource.data.active}
          && getAfter(aliasChangePath(alias,request.resource.data.revision)).data.after == {'itemId':request.resource.data.itemId,'active':request.resource.data.active};
        allow delete: if false;
      }
      match /aliasChanges/{change} {
        allow read: if member(id);
        allow create: if member(id) && request.resource.data.keys().hasAll(['aliasId','revision','before','after','actor','at'])
          && request.resource.data.keys().hasOnly(['aliasId','revision','before','after','actor','at'])
          && request.resource.data.actor == request.auth.uid && request.resource.data.at == request.time
          && request.resource.data.revision is int && change == request.resource.data.aliasId + '_' + string(request.resource.data.revision)
          && getAfter(aliasPath(request.resource.data.aliasId)).data.revision == request.resource.data.revision
          && get(aliasPath(request.resource.data.aliasId)).data.revision + 1 == request.resource.data.revision;
        allow update, delete: if false;
      }
      match /purchases/{purchase} {
        function sourcePath() { return /databases/$(database)/documents/households/$(id)/expenses/$(request.resource.data.expenseId); }
        function linePath() { return /databases/$(database)/documents/households/$(id)/expenses/$(request.resource.data.expenseId)/items/$(string(request.resource.data.itemIndex)); }
        allow read: if member(id);
        allow create: if member(id)
          && request.resource.data.keys().hasAll(['expenseId','itemIndex','itemId','name','amount','merchant','date','quantityMilli','unit','quantityVerified','active','createdBy','updatedAt'])
          && request.resource.data.keys().hasOnly(['expenseId','itemIndex','itemId','name','amount','merchant','date','quantityMilli','unit','quantityVerified','active','createdBy','updatedAt'])
          && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedAt == request.time
          && request.resource.data.itemIndex is int && request.resource.data.itemIndex >= 0
          && purchase == request.resource.data.expenseId + '_' + string(request.resource.data.itemIndex)
          && request.resource.data.name == get(linePath()).data.name
          && request.resource.data.amount == (get(sourcePath()).data.get('kind','expense') == 'refund' ? -get(linePath()).data.amount : get(linePath()).data.amount)
          && request.resource.data.merchant == get(sourcePath()).data.merchant
          && request.resource.data.date == get(sourcePath()).data.date
          && request.resource.data.quantityMilli == get(linePath()).data.get('quantityMilli',1000)
          && request.resource.data.unit == get(linePath()).data.get('unit','each')
          && request.resource.data.quantityVerified == ('quantityMilli' in get(linePath()).data)
          && request.resource.data.active == true && existsAfter(catalogPath(request.resource.data.itemId));
        allow update, delete: if false;
      }
      function correctionPath(purchase) { return /databases/$(database)/documents/households/$(id)/purchaseCorrections/$(purchase); }
      function purchaseChangePath(purchase, revision) { return /databases/$(database)/documents/households/$(id)/purchaseChanges/$(purchase + '_' + string(revision)); }
      match /purchaseCorrections/{purchase} {
        function validCorrection(data) {
          return member(id) && data.keys().hasAll(['itemId','quantityMilli','unit','quantityVerified','active','revision','updatedBy','updatedAt'])
            && data.keys().hasOnly(['itemId','quantityMilli','unit','quantityVerified','active','revision','updatedBy','updatedAt'])
            && data.quantityMilli is int && data.quantityMilli > 0 && data.quantityMilli <= 100000000
            && exists(catalogPath(data.itemId)) && unit(data.unit) && data.quantityVerified == true && data.active is bool && data.revision is int && editedByMember(data)
            && getAfter(purchaseChangePath(purchase,data.revision)).data.after == {'itemId':data.itemId,'quantityMilli':data.quantityMilli,'unit':data.unit,'quantityVerified':data.quantityVerified,'active':data.active};
        }
        allow read: if member(id);
        allow create: if validCorrection(request.resource.data) && request.resource.data.revision == 0 && exists(purchasePath(purchase))
          && getAfter(purchaseChangePath(purchase,0)).data.before == {'itemId':get(purchasePath(purchase)).data.itemId,'quantityMilli':get(purchasePath(purchase)).data.quantityMilli,'unit':get(purchasePath(purchase)).data.unit,'quantityVerified':get(purchasePath(purchase)).data.quantityVerified,'active':get(purchasePath(purchase)).data.active};
        allow update: if validCorrection(request.resource.data) && request.resource.data.revision == resource.data.revision + 1
          && getAfter(purchaseChangePath(purchase,request.resource.data.revision)).data.before == {'itemId':resource.data.itemId,'quantityMilli':resource.data.quantityMilli,'unit':resource.data.unit,'quantityVerified':resource.data.quantityVerified,'active':resource.data.active};
        allow delete: if false;
      }
      match /purchaseChanges/{change} {
        allow read: if member(id);
        allow create: if member(id) && request.resource.data.keys().hasAll(['purchaseId','revision','before','after','actor','at'])
          && request.resource.data.keys().hasOnly(['purchaseId','revision','before','after','actor','at'])
          && request.resource.data.actor == request.auth.uid && request.resource.data.at == request.time
          && request.resource.data.revision is int && change == request.resource.data.purchaseId + '_' + string(request.resource.data.revision)
          && getAfter(correctionPath(request.resource.data.purchaseId)).data.revision == request.resource.data.revision
          && request.resource.data.revision == (exists(correctionPath(request.resource.data.purchaseId)) ? get(correctionPath(request.resource.data.purchaseId)).data.revision + 1 : 0);
        allow update, delete: if false;
      }
      match /shopping/{entry} {
        function validList(data) {
          return data.keys().hasAll(['itemId','name','lastAdd','quantityMilli','unit','checked','assignedTo','notes','revision','updatedBy','updatedAt'])
            && data.keys().hasOnly(['itemId','name','lastAdd','quantityMilli','unit','checked','assignedTo','notes','revision','updatedBy','updatedAt'])
            && exists(catalogPath(data.itemId)) && data.name is string && data.name.size() > 0 && data.name.size() <= 100
            && data.quantityMilli is int && data.quantityMilli > 0 && data.quantityMilli <= 100000000000
            && unit(data.unit) && data.checked is bool && data.notes is string && data.notes.size() <= 500
            && (data.assignedTo == '' || data.assignedTo in get(housePath(id)).data.memberIds)
            && data.revision is int && editedByMember(data);
        }
        allow read: if member(id);
        allow create: if validList(request.resource.data) && request.resource.data.revision == 0
          && getAfter(/databases/$(database)/documents/households/$(id)/shoppingEvents/$(request.resource.data.lastAdd)).data.listId == entry
          && request.resource.data.quantityMilli == getAfter(/databases/$(database)/documents/households/$(id)/shoppingEvents/$(request.resource.data.lastAdd)).data.deltaMilli;
        allow update: if validList(request.resource.data) && request.resource.data.itemId == resource.data.itemId
          && request.resource.data.unit == resource.data.unit && request.resource.data.revision == resource.data.revision + 1
          && ((request.resource.data.lastAdd == resource.data.lastAdd && request.resource.data.quantityMilli == resource.data.quantityMilli)
            || (!exists(/databases/$(database)/documents/households/$(id)/shoppingEvents/$(request.resource.data.lastAdd))
              && getAfter(/databases/$(database)/documents/households/$(id)/shoppingEvents/$(request.resource.data.lastAdd)).data.listId == entry
              && request.resource.data.quantityMilli == (resource.data.checked ? 0 : resource.data.quantityMilli) + getAfter(/databases/$(database)/documents/households/$(id)/shoppingEvents/$(request.resource.data.lastAdd)).data.deltaMilli));
        allow delete: if false;
      }
      match /shoppingEvents/{event} {
        allow read: if member(id);
        allow create: if member(id) && request.resource.data.keys().hasAll(['listId','deltaMilli','actor','at'])
          && request.resource.data.keys().hasOnly(['listId','deltaMilli','actor','at'])
          && request.resource.data.actor == request.auth.uid && request.resource.data.at == request.time
          && request.resource.data.deltaMilli is int && request.resource.data.deltaMilli > 0 && request.resource.data.deltaMilli <= 100000000000
          && getAfter(/databases/$(database)/documents/households/$(id)/shopping/$(request.resource.data.listId)).data.lastAdd == event;
        allow update, delete: if false;
      }
      function stockEventPath(event) { return /databases/$(database)/documents/households/$(id)/stockEvents/$(event); }
      function stockPath(lot) { return /databases/$(database)/documents/households/$(id)/stock/$(lot); }
      function purchasePath(purchase) { return /databases/$(database)/documents/households/$(id)/purchases/$(purchase); }
      match /stock/{lot} {
        function validStock(data) {
          return data.keys().hasAll(['itemId','name','unit','quantityMilli','lowStockMilli','expiry','lastEvent','revision','updatedBy','updatedAt'])
            && data.keys().hasOnly(['itemId','name','unit','quantityMilli','lowStockMilli','expiry','lastEvent','revision','updatedBy','updatedAt'])
            && data.name is string && data.name.size() > 0 && data.name.size() <= 100 && unit(data.unit)
            && data.quantityMilli is int && data.quantityMilli >= 0 && data.quantityMilli <= 100000000000
            && data.lowStockMilli is int && data.lowStockMilli >= 0 && data.lowStockMilli <= 100000000000
            && (data.expiry == null || data.expiry is timestamp) && data.revision is int && editedByMember(data);
        }
        allow read: if member(id);
        allow create: if validStock(request.resource.data) && request.resource.data.revision == 0
          && request.resource.data.quantityMilli > 0
          && get(purchasePath(getAfter(stockEventPath(request.resource.data.lastEvent)).data.purchaseId)).data.amount > 0
          && getAfter(stockEventPath(request.resource.data.lastEvent)).data.kind == 'restock'
          && getAfter(stockEventPath(request.resource.data.lastEvent)).data.lotId == lot
          && getAfter(stockEventPath(request.resource.data.lastEvent)).data.deltaMilli == request.resource.data.quantityMilli
          && request.resource.data.itemId == get(purchasePath(getAfter(stockEventPath(request.resource.data.lastEvent)).data.purchaseId)).data.itemId;
        allow update: if validStock(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantityMilli','lastEvent','revision','updatedBy','updatedAt'])
          && request.resource.data.revision == resource.data.revision + 1
          && !exists(stockEventPath(request.resource.data.lastEvent))
          && getAfter(stockEventPath(request.resource.data.lastEvent)).data.kind == 'consume'
          && getAfter(stockEventPath(request.resource.data.lastEvent)).data.lotId == lot
          && getAfter(stockEventPath(request.resource.data.lastEvent)).data.deltaMilli < 0
          && request.resource.data.quantityMilli == resource.data.quantityMilli + getAfter(stockEventPath(request.resource.data.lastEvent)).data.deltaMilli;
        allow delete: if false;
      }
      match /stockEvents/{event} {
        allow read: if member(id);
        allow create: if member(id)
          && request.resource.data.keys().hasAll(['lotId','purchaseId','deltaMilli','actor','at','kind'])
          && request.resource.data.keys().hasOnly(['lotId','purchaseId','deltaMilli','actor','at','kind'])
          && request.resource.data.actor == request.auth.uid && request.resource.data.at == request.time
          && request.resource.data.deltaMilli is int && request.resource.data.deltaMilli != 0
          && getAfter(stockPath(request.resource.data.lotId)).data.lastEvent == event
          && ((request.resource.data.kind == 'restock' && event == 'receipt_' + request.resource.data.purchaseId
            && !exists(stockPath(request.resource.data.lotId)) && exists(purchasePath(request.resource.data.purchaseId)))
            || (request.resource.data.kind == 'consume' && request.resource.data.purchaseId == ''
              && exists(stockPath(request.resource.data.lotId))));
        allow update, delete: if false;
      }
      match /receiptSignatures/{expense} {
        allow read: if member(id);
        allow create: if member(id) && request.resource.data.keys().hasAll(['expenseId','signature','imageHash','createdBy','at'])
          && request.resource.data.keys().hasOnly(['expenseId','signature','imageHash','createdBy','at'])
          && request.resource.data.expenseId == expense && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.at == request.time && request.resource.data.signature.matches('^[a-f0-9]{64}$')
          && (request.resource.data.imageHash == '' || request.resource.data.imageHash.matches('^[a-f0-9]{64}$'))
          && exists(/databases/$(database)/documents/households/$(id)/expenses/$(expense));
        allow update, delete: if false;
      }

      function validBudgetValue(data,key) { return data.get(key,0) is int && data.get(key,0) >= 0 && data.get(key,0) <= 1000000000; }
      match /budgets/{month} {
        function validBudget(data) {
          return month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$') && editedByMember(data)
            && data.keys().hasAll(['total','categories','revision','updatedBy','updatedAt']) && data.keys().hasOnly(['total','categories','revision','updatedBy','updatedAt'])
            && data.total is int && data.total >= 0 && data.total <= 1000000000 && data.revision is int
            && data.categories is map && data.categories.keys().hasOnly(['uncategorized','food','rice','vegetables','household','utilities','other'])
            && validBudgetValue(data.categories,'uncategorized') && validBudgetValue(data.categories,'food') && validBudgetValue(data.categories,'rice')
            && validBudgetValue(data.categories,'vegetables') && validBudgetValue(data.categories,'household') && validBudgetValue(data.categories,'utilities') && validBudgetValue(data.categories,'other');
        }
        allow read: if member(id);
        allow create: if validBudget(request.resource.data) && request.resource.data.revision == 0;
        allow update: if validBudget(request.resource.data) && request.resource.data.revision == resource.data.revision + 1;
        allow delete: if false;
      }
      match /payments/{payment} {
        function validPayment(data) {
          return member(id) && data.keys().hasAll(['from','to','amount','date','month','reference','reversalOf','createdBy','createdAt'])
            && data.keys().hasOnly(['from','to','amount','date','month','reference','reversalOf','createdBy','createdAt'])
            && data.from is string && data.to is string && data.from != data.to
            && get(housePath(id)).data.memberNames.keys().hasAll([data.from,data.to])
            && data.amount is int && data.amount > 0 && data.amount <= 1000000000
            && validCalendar(data) && data.reference is string && data.reference.size() <= 300 && data.reversalOf is string
            && data.createdBy == request.auth.uid && data.createdAt == request.time;
        }
        allow read: if member(id);
        allow create: if validPayment(request.resource.data) && (
          (request.resource.data.reversalOf == '' && !payment.matches('^reverse_.*'))
          || (request.resource.data.reversalOf != '' && payment == 'reverse_' + request.resource.data.reversalOf
            && request.resource.data.reference.size() > 0
            && get(/databases/$(database)/documents/households/$(id)/payments/$(request.resource.data.reversalOf)).data.reversalOf == ''
            && get(/databases/$(database)/documents/households/$(id)/payments/$(request.resource.data.reversalOf)).data.from == request.resource.data.from
            && get(/databases/$(database)/documents/households/$(id)/payments/$(request.resource.data.reversalOf)).data.to == request.resource.data.to
            && get(/databases/$(database)/documents/households/$(id)/payments/$(request.resource.data.reversalOf)).data.amount == request.resource.data.amount
            && get(/databases/$(database)/documents/households/$(id)/payments/$(request.resource.data.reversalOf)).data.month == request.resource.data.month));
        allow update, delete: if false;
      }
      match /recurring/{template} {
        function validTemplate(data) {
          return editedByMember(data) && data.keys().hasAll(['merchant','amount','payer','category','day','enabled','revision','updatedBy','updatedAt'])
            && data.keys().hasOnly(['merchant','amount','payer','category','day','enabled','revision','updatedBy','updatedAt'])
            && data.merchant is string && data.merchant.size() > 0 && data.merchant.size() <= 100
            && data.amount is int && data.amount > 0 && data.amount <= 1000000000
            && data.payer in get(housePath(id)).data.memberIds && category(data.category)
            && data.day is int && data.day >= 1 && data.day <= 31 && data.enabled is bool && data.revision is int;
        }
        allow read: if member(id);
        allow create: if validTemplate(request.resource.data) && request.resource.data.revision == 0;
        allow update: if validTemplate(request.resource.data) && request.resource.data.revision == resource.data.revision + 1;
        allow delete: if false;
      }
      function expenseChangePath(expense, revision) { return /databases/$(database)/documents/households/$(id)/expenseChanges/$(expense + '_' + string(revision)); }
      match /expenseChanges/{change} {
        allow read: if member(id);
        allow create: if member(id) && request.resource.data.keys().hasAll(['expenseId','revision','before','after','actor','at'])
          && request.resource.data.keys().hasOnly(['expenseId','revision','before','after','actor','at'])
          && request.resource.data.actor == request.auth.uid && request.resource.data.at == request.time && request.resource.data.revision is int
          && change == request.resource.data.expenseId + '_' + string(request.resource.data.revision)
          && getAfter(/databases/$(database)/documents/households/$(id)/expenses/$(request.resource.data.expenseId)).data.revision == request.resource.data.revision
          && get(/databases/$(database)/documents/households/$(id)/expenses/$(request.resource.data.expenseId)).data.get('revision',-1) + 1 == request.resource.data.revision;
        allow update, delete: if false;
      }
      match /expenses/{expenseId} {
        function validExpense(data) {
          return data.keys().hasAll(['merchant', 'payer', 'date', 'month', 'itemCount', 'total', 'createdBy', 'createdAt'])
            && data.keys().hasOnly(['merchant', 'payer', 'date', 'month', 'itemCount', 'total', 'createdBy', 'createdAt','splitBetween','scope','category','kind','splitCents','recurringId','recurringMonth'])
            && data.get('scope','shared') == 'shared' && category(data.get('category','uncategorized')) && data.get('kind','expense') in ['expense','refund']
            && (!('splitCents' in data) || (data.splitCents is map && data.splitCents.keys().hasOnly(get(housePath(id)).data.memberIds) && data.splitCents.keys().hasAll(get(housePath(id)).data.memberIds)
              && data.splitCents[get(housePath(id)).data.memberIds[0]] is int && data.splitCents[get(housePath(id)).data.memberIds[0]] >= 0
              && (get(housePath(id)).data.memberIds.size() == 1 || (data.splitCents[get(housePath(id)).data.memberIds[1]] is int && data.splitCents[get(housePath(id)).data.memberIds[1]] >= 0))
              && data.splitCents[get(housePath(id)).data.memberIds[0]] + (get(housePath(id)).data.memberIds.size() == 1 ? 0 : data.splitCents[get(housePath(id)).data.memberIds[1]]) == data.total))
            && (!('recurringId' in data) ? !('recurringMonth' in data) : (data.recurringMonth == data.month && expenseId == 'recurring_' + data.recurringId + '_' + data.month
              && get(/databases/$(database)/documents/households/$(id)/recurring/$(data.recurringId)).data.enabled == true
              && get(/databases/$(database)/documents/households/$(id)/recurring/$(data.recurringId)).data.merchant == data.merchant
              && get(/databases/$(database)/documents/households/$(id)/recurring/$(data.recurringId)).data.amount == data.total
              && get(/databases/$(database)/documents/households/$(id)/recurring/$(data.recurringId)).data.payer == data.payer))
            && (!('splitBetween' in data) || (data.splitBetween is list && data.splitBetween.size() == get(housePath(id)).data.memberIds.size() && data.splitBetween.toSet() == get(housePath(id)).data.memberIds.toSet()))
            && data.merchant is string && data.merchant.size() > 0 && data.merchant.size() <= 100
            && data.payer in get(housePath(id)).data.memberIds
            && data.createdBy == request.auth.uid && data.createdAt == request.time
            && data.date is timestamp && data.date >= timestamp.date(2000, 1, 1) && data.date < timestamp.date(2101, 1, 1)
            && data.month is string && data.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
            && data.month == string(data.date.year()) + '-' + (data.date.month() < 10 ? '0' : '') + string(data.date.month())
            && data.total is int && data.total > 0 && data.total <= 1000000000
            && data.itemCount is int && data.itemCount >= 0 && data.itemCount <= 100;
        }
        allow read: if member(id);
        allow create: if member(id) && validExpense(request.resource.data);
        allow update: if member(id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['category','voided','revision','updatedBy','updatedAt'])
          && category(request.resource.data.category) && request.resource.data.voided is bool
          && request.resource.data.revision == resource.data.get('revision',-1) + 1 && editedByMember(request.resource.data)
          && (request.resource.data.voided == resource.data.get('voided',false) || resource.data.createdBy == request.auth.uid)
          && getAfter(expenseChangePath(expenseId,request.resource.data.revision)).data.before == {'category':resource.data.get('category','uncategorized'),'voided':resource.data.get('voided',false)}
          && getAfter(expenseChangePath(expenseId,request.resource.data.revision)).data.after == {'category':request.resource.data.category,'voided':request.resource.data.voided};
        allow delete: if false;
        match /items/{itemId} {
          function parentPath() { return /databases/$(database)/documents/households/$(id)/expenses/$(expenseId); }
          allow read: if member(id);
          allow create: if member(id)
            && !exists(parentPath())
            && getAfter(parentPath()).data.createdBy == request.auth.uid
            && getAfter(parentPath()).data.createdAt == request.time
            && request.resource.data.keys().hasOnly(['index', 'name', 'amount','quantityMilli','unit'])
            && (!('quantityMilli' in request.resource.data) || (request.resource.data.quantityMilli is int && request.resource.data.quantityMilli > 0 && request.resource.data.quantityMilli <= 100000000 && request.resource.data.unit in ['each','g','kg','ml','l']))
            && (!('unit' in request.resource.data) || 'quantityMilli' in request.resource.data)
            && request.resource.data.index is int && request.resource.data.index >= 0
            && request.resource.data.index < getAfter(parentPath()).data.itemCount
            && itemId == string(request.resource.data.index)
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
            && request.resource.data.amount is int && request.resource.data.amount >= 0 && request.resource.data.amount <= 1000000000;
          allow update, delete: if false;
        }
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
